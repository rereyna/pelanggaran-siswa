generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Pelanggaran {
  id               Int    @id @default(autoincrement())
  nis              String
  nama             String
  kelas            String
  jenis_pelanggaran String
  poin             Int
}
